<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <InvariantGlobalization>false</InvariantGlobalization>
    <AssemblyName>BluetoothDock</AssemblyName>
    <RootNamespace>BluetoothDock</RootNamespace>
    <Product>BluetoothDock</Product>
    <Description>Rychlé připojení Bluetooth sluchátek z oznamovací oblasti</Description>
    <NeutralLanguage>cs</NeutralLanguage>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
</Project>
